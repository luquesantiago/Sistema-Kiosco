# Backup diario de la base (infra/backup.sh). Lo dispara kiosco-backup.timer.
# Asume el repositorio en /opt/kiosco y el usuario kiosco (en el grupo docker),
# como indica infra/README.md. Logs: journalctl -u kiosco-backup
[Unit]
Description=Backup de la base del kiosco
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=kiosco
WorkingDirectory=/opt/kiosco
ExecStart=/bin/bash /opt/kiosco/infra/backup.sh
# Las copias tienen todos los datos del negocio: solo las lee kiosco.
UMask=0077
