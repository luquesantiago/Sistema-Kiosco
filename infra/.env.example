# Configuración de producción. Copiar a infra/.env en el servidor y completar.
# infra/.env nunca se sube al repositorio.

# Subdominio de DuckDNS (o el dominio propio), sin https://.
DOMINIO=mi-kiosco.duckdns.org

# Contraseña de la base. Solo letras y números (va dentro de la URL de conexión).
# Generarla con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Nombre que sale en el ticket y ancho del papel (58 u 80 mm).
NOMBRE_KIOSCO=Kiosco
ANCHO_TICKET=80

# Backups (infra/backup.sh): carpeta local y remoto de rclone.
BACKUP_DIR=/var/backups/kiosco
BACKUP_REMOTO=gdrive:kiosco-backups
