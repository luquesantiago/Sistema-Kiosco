# Copiar a .env para desarrollo local.
DATABASE_URL=postgresql://kiosco:kiosco@localhost:5432/kiosco
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# WhatsApp (opcional): con `pnpm whatsapp:up` levantado. Sin esto, los avisos quedan pendientes.
# WAHA_URL=http://localhost:3200
# WAHA_API_KEY=kiosco-dev

# Mercado Pago (opcional): Access Token de la aplicación del kiosco (empieza con APP_USR-).
# Sin esto, el saldo de Mercado Pago aparece como "no configurado". Nunca subirlo al repo.
# MP_ACCESS_TOKEN=
