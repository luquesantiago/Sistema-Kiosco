# Copiar a .env para desarrollo local.
DATABASE_URL=postgresql://kiosco:kiosco@localhost:5432/kiosco
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# WhatsApp (opcional): con `pnpm whatsapp:up` levantado. Sin esto, los avisos quedan pendientes.
# WAHA_URL=http://localhost:3200
# WAHA_API_KEY=kiosco-dev

# Mercado Pago (opcional): Access Token de la aplicación del kiosco (empieza con APP_USR-).
# Sin esto, el saldo de Mercado Pago aparece como "no configurado". Nunca subirlo al repo.
# MP_ACCESS_TOKEN=
# Point Smart en modo integrado (opcional, exige MP_ACCESS_TOKEN): con la terminal, débito,
# crédito y Mercado Pago se cobran con el Point. El id sale de `pnpm --filter api mp:terminales`.
# Sin esto, las ventas con tarjeta o MP se registran pagadas como siempre.
# MP_TERMINAL_ID=
# Clave secreta de las notificaciones (webhooks, evento Order), exige MP_TERMINAL_ID. Sin
# ella, el sistema solo consulta el estado de cada cobro cada 3 s.
# MP_WEBHOOK_SECRET=

# ARCA
# Factura C electrónica (opcional): todas juntas o ninguna. Sin ellas, el sistema vende
# sin facturar. En desarrollo, siempre con el certificado de homologación (WSASS).
# El certificado y la clave nunca se suben al repo (ver infra/README.md).
# ARCA_CUIT=20123456786
# ARCA_PUNTO_VENTA=5
# ARCA_ENTORNO=homologacion
# ARCA_CERT_PATH=../../infra/arca/certificado.crt
# ARCA_KEY_PATH=../../infra/arca/clave.key
# ARCA_NOMBRE_FANTASIA=Kiosco Las Flores
# ARCA_RAZON_SOCIAL=Pérez Juan
# ARCA_DOMICILIO=Av. Rivadavia 1234, Morón
# ARCA_INICIO_ACTIVIDADES=2020-03-01
# ARCA_IIBB=Exento
