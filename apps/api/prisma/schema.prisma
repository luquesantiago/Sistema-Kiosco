// Esquema de la base de datos del kiosco.
//
// Convenciones (aplican desde el primer modelo):
// - IDs: String @id @default(uuid(7)) @db.Uuid  (UUID v7, ordenables por fecha).
// - Montos: Decimal @db.Decimal(12, 2), nunca Float.
// - Cantidades y stock: Int (no hay productos por peso).
// - Fechas: DateTime @db.Timestamptz, guardadas en UTC; se convierten a hora
//   de Argentina al mostrar y al agrupar reportes.
// - Modelos y campos en español (PascalCase / camelCase), con @@map / @map a
//   tablas y columnas en snake_case.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  admin
  empleado
}

model Usuario {
  id               String              @id @default(uuid(7)) @db.Uuid
  nombre           String
  /// Siempre en minúsculas: el ingreso no distingue mayúsculas.
  usuario          String              @unique
  contrasenaHash   String              @map("contrasena_hash")
  rol              Rol
  activo           Boolean             @default(true)
  intentosFallidos Int                 @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?           @map("bloqueado_hasta") @db.Timestamptz
  ultimoIngreso    DateTime?           @map("ultimo_ingreso") @db.Timestamptz
  creadoEn         DateTime            @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn    DateTime            @updatedAt @map("actualizado_en") @db.Timestamptz
  sesiones         Sesion[]
  cambiosPrecio    CambioPrecio[]
  movimientosStock MovimientoStock[]
  ingresos         IngresoMercaderia[]
  ventas           Venta[]             @relation("VentasVendidas")
  ventasAnuladas   Venta[]             @relation("VentasAnuladas")

  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 del token de la cookie; el token nunca se guarda.
  tokenHash String   @unique @map("token_hash")
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz
  expiraEn  DateTime @map("expira_en") @db.Timestamptz

  @@index([usuarioId])
  @@map("sesiones")
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo
}

enum OrigenCambioPrecio {
  manual
  aumento_masivo
}

model Proveedor {
  id            String              @id @default(uuid(7)) @db.Uuid
  nombre        String
  telefono      String?
  notas         String?
  diasPedido    DiaSemana[]         @map("dias_pedido")
  diasEntrega   DiaSemana[]         @map("dias_entrega")
  activo        Boolean             @default(true)
  creadoEn      DateTime            @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime            @updatedAt @map("actualizado_en") @db.Timestamptz
  productos     Producto[]
  ingresos      IngresoMercaderia[]

  @@map("proveedores")
}

model Producto {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Sin espacios en los extremos. Varios productos pueden no tener código (NULL).
  codigoBarras   String?           @unique @map("codigo_barras")
  nombre         String
  /// Nombre sin acentos, en minúsculas y con espacios colapsados, para buscar.
  nombreBusqueda String            @map("nombre_busqueda")
  precio         Decimal           @db.Decimal(12, 2)
  costo          Decimal?          @db.Decimal(12, 2)
  /// Lo mueve el cambio `stock`; acá no se edita.
  stockActual    Int               @default(0) @map("stock_actual")
  stockMinimo    Int               @map("stock_minimo")
  stockMaximo    Int               @map("stock_maximo")
  proveedorId    String?           @map("proveedor_id") @db.Uuid
  proveedor      Proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  activo         Boolean           @default(true)
  creadoEn       DateTime          @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime          @updatedAt @map("actualizado_en") @db.Timestamptz
  cambiosPrecio  CambioPrecio[]
  movimientos    MovimientoStock[]
  itemsIngreso   ItemIngreso[]
  itemsVenta     ItemVenta[]

  @@index([nombreBusqueda])
  @@index([proveedorId])
  @@map("productos")
}

model CambioPrecio {
  id             String             @id @default(uuid(7)) @db.Uuid
  productoId     String             @map("producto_id") @db.Uuid
  producto       Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuarioId      String             @map("usuario_id") @db.Uuid
  usuario        Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  precioAnterior Decimal            @map("precio_anterior") @db.Decimal(12, 2)
  precioNuevo    Decimal            @map("precio_nuevo") @db.Decimal(12, 2)
  costoAnterior  Decimal?           @map("costo_anterior") @db.Decimal(12, 2)
  costoNuevo     Decimal?           @map("costo_nuevo") @db.Decimal(12, 2)
  origen         OrigenCambioPrecio
  creadoEn       DateTime           @default(now()) @map("creado_en") @db.Timestamptz

  @@index([productoId, creadoEn])
  @@map("cambios_precio")
}

enum TipoMovimiento {
  compra
  ajuste
  venta
  anulacion
}

enum MotivoAjuste {
  rotura
  vencimiento
  robo
  conteo
  venta_sin_sistema
  correccion
  otro
}

/// Registro inmutable de cada cambio de stock. Solo `registrarMovimiento` los crea.
model MovimientoStock {
  id              String             @id @default(uuid(7)) @db.Uuid
  productoId      String             @map("producto_id") @db.Uuid
  producto        Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)
  tipo            TipoMovimiento
  /// Obligatorio cuando tipo = ajuste; vacío en los demás (lo valida el servicio).
  motivo          MotivoAjuste?
  /// Con signo: positiva suma, negativa resta.
  cantidad        Int
  stockResultante Int                @map("stock_resultante")
  nota            String?
  usuarioId       String             @map("usuario_id") @db.Uuid
  usuario         Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ingresoId       String?            @map("ingreso_id") @db.Uuid
  ingreso         IngresoMercaderia? @relation(fields: [ingresoId], references: [id], onDelete: Restrict)
  ventaId         String?            @map("venta_id") @db.Uuid
  venta           Venta?             @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  creadoEn        DateTime           @default(now()) @map("creado_en") @db.Timestamptz

  @@index([productoId, creadoEn])
  @@index([ingresoId])
  @@index([ventaId])
  @@map("movimientos_stock")
}

model IngresoMercaderia {
  id          String            @id @default(uuid(7)) @db.Uuid
  proveedorId String?           @map("proveedor_id") @db.Uuid
  proveedor   Proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  usuarioId   String            @map("usuario_id") @db.Uuid
  usuario     Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  nota        String?
  creadoEn    DateTime          @default(now()) @map("creado_en") @db.Timestamptz
  items       ItemIngreso[]
  movimientos MovimientoStock[]

  @@index([creadoEn])
  @@map("ingresos_mercaderia")
}

model ItemIngreso {
  id            String            @id @default(uuid(7)) @db.Uuid
  ingresoId     String            @map("ingreso_id") @db.Uuid
  ingreso       IngresoMercaderia @relation(fields: [ingresoId], references: [id], onDelete: Restrict)
  productoId    String            @map("producto_id") @db.Uuid
  producto      Producto          @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad      Int
  /// Solo si lo cargó el admin.
  costoUnitario Decimal?          @map("costo_unitario") @db.Decimal(12, 2)

  @@index([ingresoId])
  @@map("items_ingreso")
}

enum MedioPago {
  efectivo
  debito
  credito
  mercado_pago
}

enum EstadoVenta {
  pagada
  anulada
}

enum TipoNotificacion {
  anulacion_venta
}

enum EstadoNotificacion {
  pendiente
  enviada
  error
}

/// Sin turno todavía: la Etapa 2 agrega turnoId con su migración.
model Venta {
  id              String            @id @default(uuid(7)) @db.Uuid
  /// Número legible para tickets y conversaciones ("la venta 120").
  numero          Int               @unique @default(autoincrement())
  usuarioId       String            @map("usuario_id") @db.Uuid
  usuario         Usuario           @relation("VentasVendidas", fields: [usuarioId], references: [id], onDelete: Restrict)
  total           Decimal           @db.Decimal(12, 2)
  estado          EstadoVenta       @default(pagada)
  creadaEn        DateTime          @default(now()) @map("creada_en") @db.Timestamptz
  anuladaEn       DateTime?         @map("anulada_en") @db.Timestamptz
  anuladaPorId    String?           @map("anulada_por_id") @db.Uuid
  anuladaPor      Usuario?          @relation("VentasAnuladas", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  motivoAnulacion String?           @map("motivo_anulacion")
  items           ItemVenta[]
  pagos           PagoVenta[]
  movimientos     MovimientoStock[]

  @@index([creadaEn])
  @@map("ventas")
}

model ItemVenta {
  id             String    @id @default(uuid(7)) @db.Uuid
  ventaId        String    @map("venta_id") @db.Uuid
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  /// Vacío para el ítem "Varios".
  productoId     String?   @map("producto_id") @db.Uuid
  producto       Producto? @relation(fields: [productoId], references: [id], onDelete: Restrict)
  /// Nombre del producto al momento de vender (o la descripción de "Varios").
  descripcion    String
  cantidad       Int
  precioUnitario Decimal   @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal   @db.Decimal(12, 2)

  @@index([ventaId])
  @@map("items_venta")
}

model PagoVenta {
  id            String    @id @default(uuid(7)) @db.Uuid
  ventaId       String    @map("venta_id") @db.Uuid
  venta         Venta     @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  medio         MedioPago
  monto         Decimal   @db.Decimal(12, 2)
  /// Solo para efectivo, si el empleado escribió con cuánto pagó el cliente.
  montoRecibido Decimal?  @map("monto_recibido") @db.Decimal(12, 2)
  vuelto        Decimal?  @db.Decimal(12, 2)

  @@unique([ventaId, medio])
  @@map("pagos_venta")
}

/// Aviso para el admin; el envío por WhatsApp (WAHA) llega en la Etapa 2.
model Notificacion {
  id        String             @id @default(uuid(7)) @db.Uuid
  tipo      TipoNotificacion
  /// Por ahora siempre "admin".
  destino   String
  texto     String
  estado    EstadoNotificacion @default(pendiente)
  creadaEn  DateTime           @default(now()) @map("creada_en") @db.Timestamptz
  enviadaEn DateTime?          @map("enviada_en") @db.Timestamptz
  error     String?

  @@index([creadaEn])
  @@map("notificaciones")
}
