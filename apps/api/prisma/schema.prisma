// Esquema de la base de datos del kiosco.
//
// Convenciones (aplican desde el primer modelo):
// - IDs: String @id @default(uuid(7)) @db.Uuid  (UUID v7, ordenables por fecha).
// - Montos: Decimal @db.Decimal(12, 2), nunca Float.
// - Cantidades y stock: Int (no hay productos por peso).
// - Fechas: DateTime @db.Timestamptz, guardadas en UTC; se convierten a hora
//   de Argentina al mostrar y al agrupar reportes.
// - Modelos y campos en español (PascalCase / camelCase), con @@map / @map a
//   tablas y columnas en snake_case.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  admin
  empleado
}

model Usuario {
  id               String    @id @default(uuid(7)) @db.Uuid
  nombre           String
  /// Siempre en minúsculas: el ingreso no distingue mayúsculas.
  usuario          String    @unique
  contrasenaHash   String    @map("contrasena_hash")
  rol              Rol
  activo           Boolean   @default(true)
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz
  ultimoIngreso    DateTime? @map("ultimo_ingreso") @db.Timestamptz
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn    DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz
  sesiones         Sesion[]

  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 del token de la cookie; el token nunca se guarda.
  tokenHash String   @unique @map("token_hash")
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz
  expiraEn  DateTime @map("expira_en") @db.Timestamptz

  @@index([usuarioId])
  @@map("sesiones")
}
